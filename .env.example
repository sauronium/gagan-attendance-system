# ─────────────────────────────────────────────────────────────
# Agam Ops Platform: environment variables
# Copy to .env and fill in. Never commit .env.
# NEXT_PUBLIC_* values are exposed to the browser; everything
# else stays on the server.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# Public base URL, e.g. https://ops.agamwater.in or http://localhost:3000
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=
# IANA timezone used for attendance days and display, e.g. Asia/Kolkata
APP_TIMEZONE=

# ── Database (MySQL 8 on Hostinger) ──────────────────────────
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Max pooled connections per server process (Hostinger limits these).
# Default 10, or 3 per function instance on Vercel.
DB_CONNECTION_LIMIT=

# ── Auth (sessions) ──────────────────────────────────────────
# Random 32+ byte secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Same as NEXT_PUBLIC_APP_URL in most setups
BETTER_AUTH_URL=

# ── File storage: Hostinger FTP (check-in selfies & visit photos)
# Files are uploaded by FTP into FTP_BASE_DIR/uploads and read back over
# HTTPS from STORAGE_URL/uploads. The app only shows them through its own
# /api/files route, which checks who is asking.
FTP_HOST=
FTP_PORT=
FTP_USER=
FTP_PASSWORD=
# true (default) = FTPS over TLS; false only if the server has no TLS
FTP_SECURE=
# FTP folder served at STORAGE_URL (the site's web root), e.g. public_html
FTP_BASE_DIR=
# Public host of that folder, e.g. files.agamwater.in
STORAGE_URL=
# Secret that makes stored file names unguessable (defaults to BETTER_AUTH_SECRET)
FILES_SECRET=

# ── Cloudflare R2 (alternative to FTP; preferred on Vercel) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Lifetime of signed photo URLs, in seconds
R2_SIGNED_URL_TTL=

# ── Maps (Leaflet + OpenStreetMap) ───────────────────────────
# Tile URL template, e.g. https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# ── SMS (demo SMS API in this phase) ─────────────────────────
# demo = built-in mock gateway + in-app inbox; live = real provider (later)
SMS_PROVIDER=
SMS_SENDER_ID=
# Demo only: share of messages to mark as failed, 0 to 1 (e.g. 0.1)
SMS_DEMO_FAILURE_RATE=
# Live provider only (leave empty while SMS_PROVIDER=demo)
SMS_API_URL=
SMS_API_KEY=

# ── Scheduled jobs (daily reminders, auto-absent, accruals) ──
# Shared secret the cron caller sends to the /api/cron/* routes
CRON_SECRET=

# ── First login (npm run db:seed) ────────────────────────────
# Creates the first Super Admin. Mobile as 10 digits; password 8+ chars.
# Email is optional; when set, the admin can also sign in with it.
SEED_ADMIN_NAME=
SEED_ADMIN_MOBILE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
